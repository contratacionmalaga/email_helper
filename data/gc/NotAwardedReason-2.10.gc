<?xml version="1.0" encoding="UTF-8"?>
<!-- 

		  CODICE2 Genericode File NotAwardedReason
          Direccion General del Patrimonio del Estado
		  

     -->
<gc:CodeList xsi:schemaLocation="http://docs.oasis-open.org/codelist/ns/genericode/1.0/ http://docs.oasis-open.org/codelist/cs-genericode-1.0/xsd/genericode.xsd" xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Identification>
    <ShortName>NotAwardedReason</ShortName>
    <LongName>Motivo de no adjudicación</LongName>
    <Version>2.10</Version>
    <CanonicalUri>urn:dgpe:names:specification:codice:codelist:gc:NotAwardedReason</CanonicalUri>
    <CanonicalVersionUri>urn:dgpe:names:specification:codice:codelist:gc:NotAwardedReason-2.10.gc</CanonicalVersionUri>
    <LocationUri>http://contrataciondelestado.es/codice/cl/2.10/NotAwardedReason-2.10.gc</LocationUri>
  </Identification>
  <ColumnSet>
    <Column Id="code" Use="required">
      <ShortName>Code</ShortName>
      <Data Type="normalizedString"/>
    </Column>
    <Column Id="nombre" Use="optional">
      <ShortName>Nombre</ShortName>
      <Data Type="string" Lang="es"/>
    </Column>
    <Column Id="name" Use="optional">
      <ShortName>Name</ShortName>
      <Data Type="string" Lang="en"/>
    </Column>
    <Key Id="codeKey">
      <ShortName>CodeKey</ShortName>
      <ColumnRef Ref="code"/>
    </Key>
  </ColumnSet>
  <SimpleCodeList>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>all-rej</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Todas las ofertas, solicitudes de participación y proyectos han sido retirados o se han considerado inadmisibles</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>All offers, requests for participation and projects have been withdrawn or deemed inadmissible</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>chan-need</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Decisión del comprador, debido a un cambio en las necesidades</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Decision of the buyer, due to a change in needs</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>ins-fund</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Decisión del comprador, debido a la insuficiencia de fondos</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Buyer's decision, due to insufficient funds</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>no-rece</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>No se recibieron ofertas, solicitudes de participación ni proyectos</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>No offers, requests for participation or projects were received</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>no-signed</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>El licitador / los licitadores con mejor posición se negó / se negaron a firmar el contrato</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The highest ranked bidder/bidders refused/refused to sign the contract</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>one-admis</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Solo se recibió una oferta, solicitud de participación o proyecto admisible</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Only one bid, request for participation or eligible project was received</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>other</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Otros</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Others</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>rev-body</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Decisión de un órgano competente para los procedimientos de recurso u otro órgano judicial</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Decision of a body competent for appeal procedures or another judicial body</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>rev-buyer</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Decisión del comprador a raíz de una petición de revisión de la adjudicación por el licitador</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Decision of the buyer following a request for review of the award by the bidder</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>tch-pr-error</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Decisión del comprador, no a raíz de una petición de revisión de la adjudicación por el licitador, debido a errores técnicos o de procedimiento</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Decision of the buyer, not following a request for review of the award by the bidder, due to technical or procedural errors</SimpleValue>
      </Value>
    </Row>
	
	
	
  </SimpleCodeList>
</gc:CodeList>
