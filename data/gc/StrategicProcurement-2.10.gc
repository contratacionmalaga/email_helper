      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Cumplimiento de objetivos sociales</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Fulfilment of social objectives</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>env-imp</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Reducción de los impactos ambientales</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Reduction of environmental impacts</SimpleValue>
