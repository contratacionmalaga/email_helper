<?xml version="1.0" encoding="UTF-8"?>
<!-- 

		  CODICE2 Genericode File InnovativeAcquisition
          Direccion General del Patrimonio del Estado
		  

     -->
<gc:CodeList xsi:schemaLocation="http://docs.oasis-open.org/codelist/ns/genericode/1.0/ http://docs.oasis-open.org/codelist/cs-genericode-1.0/xsd/genericode.xsd" xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Identification>
    <ShortName>InnovativeAcquisition</ShortName>
    <LongName>Objetivo innovador</LongName>
    <Version>2.10</Version>
    <CanonicalUri>urn:dgpe:names:specification:codice:codelist:gc:InnovativeAcquisition</CanonicalUri>
    <CanonicalVersionUri>urn:dgpe:names:specification:codice:codelist:gc:InnovativeAcquisition-2.10</CanonicalVersionUri>
    <LocationUri>http://contrataciondelestado.es/codice/cl/2.10/InnovativeAcquisition-2.10.gc</LocationUri>
  </Identification>
  <ColumnSet>
    <Column Id="code" Use="required">
      <ShortName>Code</ShortName>
      <Data Type="normalizedString"/>
    </Column>
    <Column Id="nombre" Use="optional">
      <ShortName>Nombre</ShortName>
      <Data Type="string" Lang="es"/>
    </Column>
    <Column Id="name" Use="optional">
      <ShortName>Name</ShortName>
      <Data Type="string" Lang="en"/>
    </Column>
    <Key Id="codeKey">
      <ShortName>CodeKey</ShortName>
      <ColumnRef Ref="code"/>
    </Key>
  </ColumnSet>
  <SimpleCodeList>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>fp-requ</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Las especificaciones técnicas se basan principalmente en requisitos funcionales y de rendimiento, no en la descripción de la solución técnica.</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The technical specifications are primarily based on functional and performance requirements, not on describing the technical solution.</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>proc-innov</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Las obras, los suministros o los servicios contratados implican la innovación de procesos.</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The procured works, supplies, or services entail process innovation</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>prod-innov</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Las obras, los suministros o los servicios contratados implican la innovación de productos.</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The procured works, supplies, or services entail product innovation</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>rd-act</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Las obras, suministros o servicios contratados incluyen actividades de investigación y desarrollo.</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The procured works, supplies or services involve research and development activities.</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>buy-eff</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Las obras, suministros o servicios contratados pueden hacer que el trabajo del comprador sea más eficaz.</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The procured works, supplies or services are likely to make the work of the buyer more effective.</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>mar-nov</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Las obras, suministros o servicios contratados son novedosos o mejoran significativamente en comparación con otras obras, suministros o servicios ya presentes en el mercado.</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The procured works, supplies or services are novel or significantly improved compared to other works, supplies, or services already on the market.</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>org-nov</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Las obras, suministros o servicios contratados son nuevos para la organización.</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The procured works, supplies or services are novel for the organisation.</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>other</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Otros</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Other</SimpleValue>
      </Value>
    </Row>
	
	
	
	
  </SimpleCodeList>
</gc:CodeList>
