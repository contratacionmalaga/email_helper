<?xml version="1.0" encoding="UTF-8"?>
<!-- 

		  CODICE2 Genericode File CVDVehicleType
          Direccion General del Patrimonio del Estado
		  

     -->
<gc:CodeList xsi:schemaLocation="http://docs.oasis-open.org/codelist/ns/genericode/1.0/ http://docs.oasis-open.org/codelist/cs-genericode-1.0/xsd/genericode.xsd" xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Identification>
    <ShortName>CVDVehicleType</ShortName>
    <LongName>Tipología de vehículos acorde a la directiva de vehículos límpios</LongName>
    <Version>2.10</Version>
    <CanonicalUri>urn:dgpe:names:specification:codice:codelist:gc:CVDVehicleType</CanonicalUri>
    <CanonicalVersionUri>urn:dgpe:names:specification:codice:codelist:gc:CVDVehicleType-2.10</CanonicalVersionUri>
    <LocationUri>http://contrataciondelestado.es/codice/cl/2.10/CVDVehicleType-2.10.gc</LocationUri>
  </Identification>
  <ColumnSet>
    <Column Id="code" Use="required">
      <ShortName>Code</ShortName>
      <Data Type="normalizedString"/>
    </Column>
    <Column Id="nombre" Use="optional">
      <ShortName>Nombre</ShortName>
      <Data Type="string" Lang="es"/>
    </Column>
    <Column Id="name" Use="optional">
      <ShortName>Name</ShortName>
      <Data Type="string" Lang="en"/>
    </Column>
    <Key Id="codeKey">
      <ShortName>CodeKey</ShortName>
      <ColumnRef Ref="code"/>
    </Key>
  </ColumnSet>
  <SimpleCodeList>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>vehicles</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Vehículos</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Vehicles</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>vehicles-clean</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Vehículos limpios</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Vehicles clean</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>vehicles-zero-emission</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Vehículos cero emisiones</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Vehicles zero emission</SimpleValue>
      </Value>
    </Row>

  </SimpleCodeList>
</gc:CodeList>
