<gc:CodeList xsi:schemaLocation="http://docs.oasis-open.org/codelist/ns/genericode/1.0/ http://docs.oasis-open.org/codelist/cs-genericode-1.0/xsd/genericode.xsd" xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Identification>
    <ShortName>EnvironmentalImpact</ShortName>
    <LongName>Contratación verde</LongName>
    <Version>2.10</Version>
    <CanonicalUri>urn:dgpe:names:specification:codice:codelist:gc:EnvironmentalImpact</CanonicalUri>
    <CanonicalVersionUri>urn:dgpe:names:specification:codice:codelist:gc:EnvironmentalImpact-2.10</CanonicalVersionUri>
    <LocationUri>http://contrataciondelestado.es/codice/cl/2.10/EnvironmentalImpact-2.10.gc</LocationUri>
  </Identification>
  <ColumnSet>
    <Column Id="code" Use="required">
      <ShortName>Code</ShortName>
      <Data Type="normalizedString"/>
    </Column>
    <Column Id="nombre" Use="optional">
      <ShortName>Nombre</ShortName>
      <Data Type="string" Lang="es"/>
    </Column>
    <Column Id="name" Use="optional">
      <ShortName>Name</ShortName>
      <Data Type="string" Lang="en"/>
    </Column>
    <Key Id="codeKey">
      <ShortName>CodeKey</ShortName>
      <ColumnRef Ref="code"/>
    </Key>
  </ColumnSet>
  <SimpleCodeList>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>clim-adapt</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Adaptación al cambio climático</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Climate change adaptation</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>clim-mitig</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Mitigación del cambio climático</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Climate change mitigation</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>other</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Otros</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Other</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>pollu-prev</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Prevención y control de la contaminación</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Pollution prevention and control</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>biodiv-eco</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Protección y recuperación de la biodiversidad y los ecosistemas</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The protection and restoration of biodiversity and ecosystems</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>circ-econ</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Transición hacia una economía circular</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The transition to a circular economy</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>water-mar</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Uso sostenible y protección de los recursos hídricos y marinos</SimpleValue>
      </Value>
      <Value ColumnRef="name">
