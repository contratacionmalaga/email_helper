<?xml version="1.0" encoding="UTF-8"?>
<!-- 

		  CODICE2 Genericode File SocialObjective
          Direccion General del Patrimonio del Estado
		  

     -->
<gc:CodeList xsi:schemaLocation="http://docs.oasis-open.org/codelist/ns/genericode/1.0/ http://docs.oasis-open.org/codelist/cs-genericode-1.0/xsd/genericode.xsd" xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Identification>
    <ShortName>SocialObjective</ShortName>
    <LongName>Objetivo social promovido</LongName>
    <Version>2.10</Version>
    <CanonicalUri>urn:dgpe:names:specification:codice:codelist:gc:SocialObjective</CanonicalUri>
    <CanonicalVersionUri>urn:dgpe:names:specification:codice:codelist:gc:SocialObjective-2.10</CanonicalVersionUri>
    <LocationUri>http://contrataciondelestado.es/codice/cl/2.10/SocialObjective-2.10.gc</LocationUri>
  </Identification>
  <ColumnSet>
    <Column Id="code" Use="required">
      <ShortName>Code</ShortName>
      <Data Type="normalizedString"/>
    </Column>
    <Column Id="nombre" Use="optional">
      <ShortName>Nombre</ShortName>
      <Data Type="string" Lang="es"/>
    </Column>
    <Column Id="name" Use="optional">
      <ShortName>Name</ShortName>
      <Data Type="string" Lang="en"/>
    </Column>
    <Key Id="codeKey">
      <ShortName>CodeKey</ShortName>
      <ColumnRef Ref="code"/>
    </Key>
  </ColumnSet>
  <SimpleCodeList>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>acc-all</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Accesibilidad para todos</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Accessibility for all</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>work-cond</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Condiciones de trabajo justas</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Fair working conditions</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>hum-right</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Diligencia debida en materia de derechos humanos en las cadenas de suministro globales</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Human rights due diligence in global supply chains</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>gen-eq</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Igualdad de género</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Gender equality</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>et-eq</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Igualdad étnica</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Ethnic equality</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>opp</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Oportunidades de empleo para desempleados de larga duración, personas desfavorecidas o personas con discapacidad</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Employment opportunities for the long-term unemployed, disadvantaged and/or for persons with disabilities</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>other</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Otros</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Other</SimpleValue>
      </Value>
    </Row>
	
	
	
	
  </SimpleCodeList>
</gc:CodeList>
