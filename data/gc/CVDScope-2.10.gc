<?xml version="1.0" encoding="UTF-8"?>
<!-- 

		  CODICE2 Genericode File CVDScope
          Direccion General del Patrimonio del Estado
		  

     -->
<gc:CodeList xsi:schemaLocation="http://docs.oasis-open.org/codelist/ns/genericode/1.0/ http://docs.oasis-open.org/codelist/cs-genericode-1.0/xsd/genericode.xsd" xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Identification>
    <ShortName>CVDScope</ShortName>
    <LongName>Ámbito de amplicación de la Directiva de Vehiculos Límpios</LongName>
    <Version>2.10</Version>
    <CanonicalUri>urn:dgpe:names:specification:codice:codelist:gc:CVDScope</CanonicalUri>
    <CanonicalVersionUri>urn:dgpe:names:specification:codice:codelist:gc:CVDScope-2.10</CanonicalVersionUri>
    <LocationUri>http://contrataciondelestado.es/codice/cl/2.10/CVDScope-2.10.gc</LocationUri>
  </Identification>
  <ColumnSet>
    <Column Id="code" Use="required">
      <ShortName>Code</ShortName>
      <Data Type="normalizedString"/>
    </Column>
    <Column Id="nombre" Use="optional">
      <ShortName>Nombre</ShortName>
      <Data Type="string" Lang="es"/>
    </Column>
    <Column Id="name" Use="optional">
      <ShortName>Name</ShortName>
      <Data Type="string" Lang="en"/>
    </Column>
    <Key Id="codeKey">
      <ShortName>CodeKey</ShortName>
      <ColumnRef Ref="code"/>
    </Key>
  </ColumnSet>
  <SimpleCodeList>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>no-CVD</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>No aplica la Directiva de Vehículos Límpios</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The Clean Vehicles Directive does not apply</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>veh-acq</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Aplica la Directiva de Vehículos límpios respecto a la compra, arrendamiento o alquiler de vehículos</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The Clean Vehicles Directive applies regarding the purchase, lease or rental of vehicles</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>oth-serv-cont</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Aplica la Directiva de Vehículos límpios para otros contratos de servicios</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The Clean Vehicles Directive applies to other service contracts</SimpleValue>
      </Value>
    </Row>
	<Row>
      <Value ColumnRef="code">
        <SimpleValue>pass-tran-serv</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Aplica la Directiva de Vehículos límpios para servicios de transporte de viajeros por carretera</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>The Clean Vehicles Directive applies to passenger road transport services</SimpleValue>
      </Value>
    </Row>
		
  </SimpleCodeList>
</gc:CodeList>
