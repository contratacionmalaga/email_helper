<?xml version="1.0" encoding="UTF-8"?>
<!-- 

		  CODICE2 Genericode File ExpenseTypeCode
          Direccion General del Patrimonio del Estado
		  

     -->
<gc:CodeList xsi:schemaLocation="http://docs.oasis-open.org/codelist/ns/genericode/1.0/ http://docs.oasis-open.org/codelist/cs-genericode-1.0/xsd/genericode.xsd" xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Identification>
    <ShortName>ExpenseTypeCode</ShortName>
    <LongName>C&#243;digo de Tramitaci&#243;n del Gasto</LongName>
    <Version>2006</Version>
    <CanonicalUri>urn:dgpe:names:specification:codice:codelist:gc:ExpenseTypeCode</CanonicalUri>
    <CanonicalVersionUri>urn:dgpe:names:specification:codice:codelist:gc:ExpenseTypeCode-2006</CanonicalVersionUri>
    <LocationUri>http://contrataciondelestado.es/codice/cl/1.04/ExpenseTypeCode-1.04.gc</LocationUri>
  </Identification>
  <ColumnSet>
    <Column Id="code" Use="required">
      <ShortName>Code</ShortName>
      <Data Type="normalizedString"/>
    </Column>
    <Column Id="nombre" Use="optional">
      <ShortName>Nombre</ShortName>
      <Data Type="string" Lang="es"/>
    </Column>
    <Column Id="name" Use="optional">
      <ShortName>Name</ShortName>
      <Data Type="string" Lang="en"/>
    </Column>
    <Key Id="codeKey">
      <ShortName>CodeKey</ShortName>
      <ColumnRef Ref="code"/>
    </Key>
  </ColumnSet>
  <SimpleCodeList>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>1</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Ordinaria</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Normal</SimpleValue>
      </Value>
    </Row>
    <Row>
      <Value ColumnRef="code">
        <SimpleValue>2</SimpleValue>
      </Value>
      <Value ColumnRef="nombre">
        <SimpleValue>Anticipada</SimpleValue>
      </Value>
      <Value ColumnRef="name">
        <SimpleValue>Anticipated</SimpleValue>
      </Value>
    </Row>
  </SimpleCodeList>
</gc:CodeList>
